{
  "manifest_version": 2,
  "name": "Anubis Fast",
  "version": "0.1.0",
  "description": "Use a local native solver for proof-of-work challenge pages.",
  "icons": {
    "64": "icon.svg",
    "128": "icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "anubis-fast@mikenrafter",
      "strict_min_version": "109.0"
    }
  },
  "permissions": ["nativeMessaging", "cookies", "tabs", "notifications", "<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["providers/anubis.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_icon": {
      "64": "icon.svg",
      "128": "icon.svg"
    },
    "default_title": "Anubis Fast"
  }
}
