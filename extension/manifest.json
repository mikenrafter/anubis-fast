{
  "manifest_version": 2,
  "name": "Anubis Fast",
  "version": "0.1.0",
  "description": "Use a local native solver for proof-of-work challenge pages.",
  "browser_specific_settings": {
    "gecko": {
      "id": "anubis-fast@slaughter.pro",
      "strict_min_version": "109.0"
    }
  },
  "permissions": ["nativeMessaging", "cookies", "tabs"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["providers/anubis.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": ["background.js"]
  }
}
